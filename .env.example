# ==============================================================================
# Invinite Personal Finance PWA SaaS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit .env to Git! It is explicitly excluded by .gitignore.
# ==============================================================================

# Server Listener
HOST=127.0.0.1
PORT=8080

# Database Configuration
DATABASE_URL=

# Authentication & Security
# Generate with: openssl rand -hex 32 (MUST be at least 32 characters)
JWT_SECRET=replace_with_secure_random_jwt_secret_minimum_32_characters
JWT_TTL_SECONDS=900
COOKIE_SECURE=true
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECS=900

# Payment Gateways (Midtrans & Xendit)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_MIDTRANS_SERVER_KEY
XENDIT_WEBHOOK_TOKEN=YOUR_XENDIT_CALLBACK_VERIFICATION_TOKEN

# DANA Open API (Sandbox / Production Credentials)
# DANA_PUBLIC_KEY and DANA_PRIVATE_KEY should be Base64-encoded PKCS#8 or PEM without line breaks
DANA_API_BASE_URL=https://api.sandbox.dana.id
DANA_MERCHANT_ID=YOUR_DANA_MERCHANT_ID
DANA_CLIENT_ID=YOUR_DANA_CLIENT_ID
DANA_CLIENT_SECRET=YOUR_DANA_CLIENT_SECRET
DANA_PUBLIC_KEY=YOUR_DANA_PUBLIC_KEY_BASE64
DANA_PRIVATE_KEY=YOUR_DANA_PRIVATE_KEY_BASE64

# Application & Frontend Dist
APP_ENV=production
LOG_LEVEL=info
WEB_DIST=dist
