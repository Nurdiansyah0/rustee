# ==============================================================================
# Invinite Personal Finance PWA — Git Ignore Specification
# ==============================================================================

# Environment & Secret Configurations (STRICTLY PROHIBITED FROM GIT)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.rsa


# Node & Frontend Build Artifacts
node_modules/
dist/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
frontend/.vite/

# Rust Build Artifacts
target/
**/*.rs.bk
*.rs.bk

# SQLite Databases & Ephemeral State
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Runtime Logs
logs/
*.log
/tmp/
__pycache__/
*.py[cod]

# OS & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Multi-Agent Workspace Scratch Dirs
.agents
.agents/
.agents/**
